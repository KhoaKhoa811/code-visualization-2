{"schemaVersion":"1.12.0","runId":"test-dp-memo","source":{"file":"Main.java","text":"import java.util.*;\npublic class Main {\n    static long fib(int n, long[] memo) {\n        if (n < 2) return n;\n        if (memo[n] != -1) return memo[n];\n        long r = fib(n - 1, memo) + fib(n - 2, memo);\n        memo[n] = r;\n        return r;\n    }\n    static long fibMap(int n, Map<Integer, Long> memo) {\n        if (n < 2) return n;\n        if (memo.containsKey(n)) return memo.get(n);\n        long r = fibMap(n - 1, memo) + fibMap(n - 2, memo);\n        memo.put(n, r);\n        return r;\n    }\n    public static void main(String[] args) {\n        long[] memo = new long[7];\n        Arrays.fill(memo, -1);\n        Map<Integer, Long> cache = new HashMap<>();\n        System.out.println(fib(6, memo) + \" \" + fibMap(6, cache));\n    }\n}\n","sha256":"41e1aa0e7e40cb464b62f02fed2aec9ae57fb9383c20aa981adaf65530c612ba"},"execution":{"status":"completed","reason":"Normal return from main."},"capture":{"status":"complete","reason":"All covered operations were recorded.","safeEventCount":163},"diagnostics":[],"initialState":{"objects":[{"objectId":"o1","kind":"array","elementType":"java.lang.String","elements":[]}],"frames":[{"frameId":"f0","methodId":"Main.main(java.lang.String[]):void","callerFrameId":null}],"scopes":[{"scopeId":"s1","frameId":"f0","parentScopeId":null}],"bindings":[{"bindingId":"b1","declarationId":"Main.main:args","frameId":"f0","scopeId":"s1","name":"args","javaType":"java.lang.String[]","value":{"kind":"ref","objectId":"o1"}}]},"events":[{"seq":1,"step":1,"source":{"start":567,"end":578},"frameId":"f0","kind":"ALLOCATE","data":{"object":{"objectId":"o2","kind":"array","elementType":"long","elements":[{"kind":"long","value":"0"},{"kind":"long","value":"0"},{"kind":"long","value":"0"},{"kind":"long","value":"0"},{"kind":"long","value":"0"},{"kind":"long","value":"0"},{"kind":"long","value":"0"}]}}},{"seq":2,"step":2,"source":{"start":553,"end":578},"fram