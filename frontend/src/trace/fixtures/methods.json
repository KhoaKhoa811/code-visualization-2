{"schemaVersion":"1.4.0","runId":"test-methods-recursion","source":{"file":"Main.java","text":"public class Main {\n    static int factorial(int n) {\n        if (n <= 1) return 1;\n        return n * factorial(n - 1);\n    }\n    static void swap(int[] a, int i, int j) {\n        int t = a[i];\n        a[i] = a[j];\n        a[j] = t;\n    }\n    static boolean even(int n) { return n % 2 == 0; }\n    static double half(long x) { return x / 2.0; }\n    static int len(int[] a) { return a.length; }\n    static int len(String[] s) { return s.length; }\n    static void noop() { }\n    public static void main(String[] args) {\n        int f = factorial(3);\n        int[] a = {3, 1, 2};\n        swap(a, 0, 2);\n        if (even(f)) f++;\n        factorial(1);\n        double h = half(5L);\n        noop();\n        int n = len(a) + len(new String[]{\"x\"});\n        System.out.println(f);\n        System.out.println(a[0]);\n        System.out.println(h);\n        System.out.println(n);\n    }\n}\n","sha256":"98e01440413098dbfbb6ba50e8f7d77d7ea735d672a997b957eb31a3e2257b60"},"execution":{"status":"completed","reason":"Normal return from main."},"capture":{"status":"complete","reason":"All covered operations were recorded.","safeEventCount":50},"diagnostics":[],"initialState":{"objects":[{"objectId":"o1","kind":"array","elementType":"java.lang.String","elements":[]}],"frames":[{"frameId":"f0","methodId":"Main.main(java.lang.String[]):void","callerFrameId":null}],"scopes":[{"scopeId":"s1","frameId":"f0","parentScopeId":null}],"bindings":[{"bindingId":"b1","declarationId":"Main.main:args","frameId":"f0","scopeId":"s1","name":"args","javaType":"java.lang.String[]","value":{"kind":"ref","objectId":"o1"}}]},"events":[{"seq":1,"step":1,"source":{"start":534,"end":546},"frameId":"f0","kind":"CALL","data":{"frame":{"frameId":"f1","methodId":"Main.factorial(int):int","callerFrameId":"f0"},"scope":{"scopeId":"s2","frameId":"f1","parentScopeId":null},"parameters":[{"bindingId":"b2","dec