{"schemaVersion":"1.5.0","runId":"test-objects-list-tree","source":{"file":"Main.java","text":"public class Main {\n    static class Node {\n        int val;\n        Node next;\n        Node(int v) { val = v; }\n    }\n    static class Tree {\n        int key;\n        Tree left, right;\n        Tree(int k) { key = k; }\n        void insert(int k) {\n            if (k < key) { if (left == null) left = new Tree(k); else left.insert(k); }\n            else { if (right == null) right = new Tree(k); else right.insert(k); }\n        }\n        int size() { return 1 + (left == null ? 0 : left.size()) + (right == null ? 0 : right.size()); }\n    }\n    public static void main(String[] args) {\n        Node head = new Node(1);\n        head.next = new Node(2);\n        head.next.next = new Node(3);\n        int sum = 0;\n        for (Node n = head; n != null; n = n.next) sum += n.val;\n        Tree root = new Tree(5);\n        root.insert(3);\n        root.insert(8);\n        root.insert(4);\n        System.out.println(sum);\n        System.out.println(root.size());\n        System.out.println(root.left.right.key);\n    }\n}\n","sha256":"3befa21c865affaf256207e8ec58112f6e2243c11e79636ff276c2e67a711ea5"},"execution":{"status":"completed","reason":"Normal return from main."},"capture":{"status":"complete","reason":"All covered operations were recorded.","safeEventCount":131},"diagnostics":[],"initialState":{"objects":[{"objectId":"o1","kind":"array","elementType":"java.lang.String","elements":[]}],"frames":[{"frameId":"f0","methodId":"Main.main(java.lang.String[]):void","callerFrameId":null}],"scopes":[{"scopeId":"s1","frameId":"f0","parentScopeId":null}],"bindings":[{"bindingId":"b1","declarationId":"Main.main:args","frameId":"f0","scopeId":"s1","name":"args","javaType":"java.lang.String[]","value":{"kind":"ref","objectId":"o1"}}]},"events":[{"seq":1,"step":1,"source":{"start":605,"end":616},"frameId":"f0","kind":"ALLOCATE","data":{"object":{"objectId":"o2","kind":"object",