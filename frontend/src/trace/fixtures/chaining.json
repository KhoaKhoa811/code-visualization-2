{"schemaVersion":"1.12.0","runId":"test-chaining","source":{"file":"Main.java","text":"public class Main {\n    static class Entry { int key, val; Entry next; Entry(int k, int v, Entry n) { key = k; val = v; next = n; } }\n    static class Table {\n        Entry[] buckets = new Entry[4];\n        void put(int k, int v) {\n            int b = k % 4;\n            for (Entry e = buckets[b]; e != null; e = e.next) if (e.key == k) { e.val = v; return; }\n            buckets[b] = new Entry(k, v, buckets[b]);\n        }\n    }\n    public static void main(String[] args) {\n        Table t = new Table();\n        t.put(1, 10); t.put(5, 50); t.put(2, 20); t.put(1, 11);\n        System.out.println(t.buckets[1].val + \" \" + t.buckets[1].next.val);\n    }\n}\n","sha256":"f66646cb2b501a37304a5b6e4f49302f0c6bf2330cf1b98e0609ee4f5b81a1c4"},"execution":{"status":"completed","reason":"Normal return from main."},"capture":{"status":"complete","reason":"All covered operations were recorded.","safeEventCount":100},"diagnostics":[],"initialState":{"objects":[{"objectId":"o1","kind":"array","elementType":"java.lang.String","elements":[]}],"frames":[{"frameId":"f0","methodId":"Main.main(java.lang.String[]):void","callerFrameId":null}],"scopes":[{"scopeId":"s1","frameId":"f0","parentScopeId":null}],"bindings":[{"bindingId":"b1","declarationId":"Main.main:args","frameId":"f0","scopeId":"s1","name":"args","javaType":"java.lang.String[]","value":{"kind":"ref","objectId":"o1"}}]},"events":[{"seq":1,"step":1,"source":{"start":493,"end":504},"frameId":"f0","kind":"ALLOCATE","data":{"object":{"objectId":"o2","kind":"object","className":"Main.Table","fields":[{"name":"buckets","javaType":"Main.Entry[]","value":{"kind":"null"}}]}}},{"seq":2,"step":2,"source":{"start":493,"end":504},"frameId":"f0","kind":"CALL","data":{"frame":{"frameId":"f1","methodId":"Main.Table.<init>():void","callerFrameId":"f0"},"scope":{"scopeId":"s2","frameId":"f1","parentScopeId":null},"parameters":[{"bindingId":"b2","decl