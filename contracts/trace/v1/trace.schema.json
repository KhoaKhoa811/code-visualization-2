            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "skipped": {
              "const": true
            }
          },
          "required": [
            "skipped"
          ],
          "additionalProperties": false
        }
      ]
