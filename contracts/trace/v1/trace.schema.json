{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KhoaKhoa811/code-visualization-2/contracts/trace/v1/trace.schema.json",
  "title": "Recorded Java trace 1.0.0",
  "description": "Candidate contract. Structural validity is not proof of Java execution or semantic replay correctness.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "runId": {
      "$ref": "#/$defs/id"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "capture": {
      "$ref": "#/$defs/capture"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "initialState": {
      "oneOf": [
        {
          "$ref": "#/$defs/state"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "stepEnds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/positive"
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "source",
    "execution",
    "capture",
    "diagnostics",
    "initialState",
    "events",
    "stepEnds"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "capture": {
          "type": "object",
          "properties": {
            "status": {
              "const": "complete"
            }
          }
        },
        "execution": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "failed"
              ]
            }
          }
        },
        "initialState": {
          "$ref": "#/$defs/state"
        }
      }
    },
    {
      "properties": {
        "capture": {
          "type": "object",
          "properties": {
            "status": {
              "const": "partial"
            }
          }
        },
        "execution": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "failed",
                "cancelled",
                "limited"
              ]
            }
          }
        },
        "initialState": {
          "$ref": "#/$defs/state"
        }
      }
    },
    {
      "properties": {
        "capture": {
          "type": "object",
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "safeEventCount": {
              "const": 0
            }
          }
        },
        "initialState": {
          "type": "null"
        },
        "events": {
          "type": "array",
          "maxItems": 0
        },
        "stepEnds": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sourceRange": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/count"
        },
        "end": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "byte"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "short"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "int"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "long"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "char"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "float"
            },
            "bits": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "bits"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "double"
            },
            "bits": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "bits"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ref"
            },
            "objectId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "objectId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "null"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "bindingValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unassigned"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "javaType": {
      "type": "string",
      "enum": [
        "byte",
        "short",
        "int",
        "long",
        "char",
        "boolean",
        "float",
        "double",
        "java.lang.String",
        "byte[]",
        "short[]",
        "int[]",
        "long[]",
        "char[]",
        "boolean[]",
        "float[]",
        "double[]",
        "java.lang.String[]"
