        },
        "frameId": {
          "$ref": "#/$defs/id"
        },
        "parentScopeId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scopeId",
        "frameId",
        "parentScopeId"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "bindingId": {
          "$ref": "#/$defs/id"
        },
        "declarationId": {
          "$ref": "#/$defs/id"
        },
        "frameId": {
          "$ref": "#/$defs/id"
        },
        "scopeId": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "javaType": {
          "$ref": "#/$defs/javaType"
        },
        "value": {
