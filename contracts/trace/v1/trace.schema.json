{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KhoaKhoa811/code-visualization-2/contracts/trace/v1/trace.schema.json",
  "title": "Recorded Java trace 1.7.0",
  "description": "Candidate contract. Structural validity is not proof of Java execution or semantic replay correctness.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.7.0"
    },
    "runId": {
      "$ref": "#/$defs/id"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "capture": {
      "$ref": "#/$defs/capture"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "initialState": {
      "oneOf": [
        {
          "$ref": "#/$defs/state"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "stepEnds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/positive"
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "source",
    "execution",
    "capture",
    "diagnostics",
    "initialState",
    "events",
    "stepEnds"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "capture": {
          "type": "object",
          "properties": {
            "status": {
              "const": "complete"
            }
          }
        },
        "execution": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "failed"
              ]
            }
          }
        },
        "initialState": {
          "$ref": "#/$defs/state"
        }
      }
    },
    {
      "properties": {
        "capture": {
          "type": "object",
          "properties": {
            "status": {
              "const": "partial"
            }
          }
        },
        "execution": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "failed",
                "cancelled",
                "limited"
              ]
            }
          }
        },
        "initialState": {
          "$ref": "#/$defs/state"
        }
      }
    },
    {
      "properties": {
        "capture": {
          "type": "object",
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "safeEventCount": {
              "const": 0
            }
          }
        },
        "initialState": {
          "type": "null"
        },
        "events": {
          "type": "array",
          "maxItems": 0
        },
        "stepEnds": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sourceRange": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/count"
        },
        "end": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "byte"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "short"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "int"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "long"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "char"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "float"
            },
            "bits": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "bits"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "double"
            },
            "bits": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}(?![\\s\\S])"
            }
          },
          "required": [
            "kind",
            "bits"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ref"
            },
            "objectId": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "objectId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "null"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "bindingValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unassigned"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "javaType": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$.<>,?| \\[\\]]*(?![\\s\\S])",
      "description": "A primitive type, java.lang.String, a traced class (1.4.0, for example Node or Main.Node), or an array of those at any depth. Since 1.5.0 generic arguments are kept (java.util.List<java.lang.Integer>). Since 1.7.0 a multi-catch parameter has a union type (java.lang.IllegalStateException | java.lang.ArithmeticException)."
    },
    "frame": {
      "type": "object",
      "properties": {
        "frameId": {
          "$ref": "#/$defs/id"
        },
        "methodId": {
          "$ref": "#/$defs/id"
        },
        "callerFrameId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "frameId",
        "methodId",
        "callerFrameId"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "scopeId": {
          "$ref": "#/$defs/id"
        },
        "frameId": {
          "$ref": "#/$defs/id"
        },
        "parentScopeId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scopeId",
        "frameId",
        "parentScopeId"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "bindingId": {
          "$ref": "#/$defs/id"
        },
        "declarationId": {
          "$ref": "#/$defs/id"
        },
        "frameId": {
          "$ref": "#/$defs/id"
        },
        "scopeId": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "javaType": {
          "$ref": "#/$defs/javaType"
        },
        "value": {
          "$ref": "#/$defs/bindingValue"
        }
      },
      "required": [
        "bindingId",
        "declarationId",
        "frameId",
        "scopeId",
        "name",
        "javaType",
        "value"
      ],
      "additionalProperties": false
    },
    "arrayObject": {
      "type": "object",
      "properties": {
        "objectId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "array"
        },
        "elementType": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$.<>,? \\[\\]]*(?![\\s\\S])",
          "description": "Component type: a primitive, java.lang.String, a traced class (1.4.0), or an array type of those."
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateValue"
          }
        }
      },
      "required": [
        "objectId",
        "kind",
        "elementType",
        "elements"
      ],
      "additionalProperties": false
    },
    "stringObject": {
      "type": "object",
      "properties": {
        "objectId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "string"
        },
        "utf16": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        }
      },
      "required": [
        "objectId",
        "kind",
        "utf16"
      ],
      "additionalProperties": false
    },
    "objectObject": {
      "type": "object",
      "description": "An instance of a traced class (1.4.0). Fields are in declaration order.",
      "properties": {
        "objectId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "object"
        },
        "className": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(.[A-Za-z_$][A-Za-z0-9_$]*)*(?![sS])"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "javaType": {
                "$ref": "#/$defs/javaType"
              },
              "value": {
                "$ref": "#/$defs/stateValue"
              }
            },
            "required": [
              "name",
              "javaType",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "objectId",
        "kind",
        "className",
        "fields"
      ],
      "additionalProperties": false
    },
    "collectionObject": {
      "type": "object",
      "description": "A library collection (1.5.0): list, deque, stack, set or priority queue. Elements in iteration order; ascending for HashSet; poll order for PriorityQueue.",
      "properties": {
        "objectId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "collection"
        },
        "className": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$.]*(?![\\s\\S])"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateValue"
          }
        }
      },
      "required": [
        "objectId",
        "kind",
        "className",
        "elements"
      ],
      "additionalProperties": false
    },
    "mapObject": {
      "type": "object",
      "description": "A library map (1.5.0). Entries in iteration order; ascending key order for HashMap.",
      "properties": {
        "objectId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "map"
        },
        "className": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$.]*(?![\\s\\S])"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/stateValue"
              },
              "value": {
                "$ref": "#/$defs/stateValue"
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "objectId",
        "kind",
        "className",
        "entries"
      ],
      "additionalProperties": false
    },
    "builderObject": {
      "type": "object",
      "description": "A StringBuilder (1.5.0) and its current text.",
      "properties": {
        "objectId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "builder"
        },
        "className": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$.]*(?![\\s\\S])"
        },
        "utf16": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        }
      },
      "required": [
        "objectId",
        "kind",
        "className",
        "utf16"
      ],
      "additionalProperties": false
    },
    "inputObject": {
      "type": "object",
      "description": "A Scanner reading standard input (1.6.0). Its reads are LIBRARY steps; it has no other state.",
      "properties": {
        "objectId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "input"
        },
        "className": {
          "type": "string",
          "const": "java.util.Scanner"
        }
      },
      "required": [
        "objectId",
        "kind",
        "className"
      ],
      "additionalProperties": false
    },
    "object": {
      "oneOf": [
        {
          "$ref": "#/$defs/arrayObject"
        },
        {
          "$ref": "#/$defs/stringObject"
        },
        {
          "$ref": "#/$defs/objectObject"
        },
        {
          "$ref": "#/$defs/collectionObject"
        },
        {
          "$ref": "#/$defs/mapObject"
        },
        {
          "$ref": "#/$defs/builderObject"
        },
        {
          "$ref": "#/$defs/inputObject"
        },
        {
          "$ref": "#/$defs/exceptionObject"
        }
      ]
    },
    "state": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      },
      "required": [
        "objects",
        "frames",
        "scopes",
        "bindings"
      ],
      "additionalProperties": false
    },
    "operand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "skipped": {
              "const": true
            }
          },
          "required": [
            "skipped"
          ],
          "additionalProperties": false
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "compile",
            "admission",
            "capture",
            "execution"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/sourceRange"
        }
      },
      "required": [
        "phase",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "file": {
          "const": "Main.java"
        },
        "text": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "file",
        "text",
        "sha256"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "limited",
            "compile_error",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "safeEventCount": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "status",
        "reason",
        "safeEventCount"
      ],
      "additionalProperties": false
    },
    "DECLARE": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "#/$defs/positive"
        },
        "step": {
          "$ref": "#/$defs/positive"
        },
        "source": {
          "$ref": "#/$defs/sourceRange"
        },
        "frameId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "DECLARE"
        },
        "data": {
          "type": "object",
          "properties": {
            "binding": {
              "$ref": "#/$defs/binding"
            }
          },
          "required": [
            "binding"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "seq",
        "step",
        "source",
        "frameId",
        "kind",
        "data"
      ],
      "additionalProperties": false
    },
    "ASSIGN": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "#/$defs/positive"
        },
        "step": {
          "$ref": "#/$defs/positive"
        },
        "source": {
          "$ref": "#/$defs/sourceRange"
        },
        "frameId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "ASSIGN"
        },
        "data": {
          "type": "object",
          "properties": {
            "bindingId": {
              "$ref": "#/$defs/id"
            },
            "previous": {
              "$ref": "#/$defs/bindingValue"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "bindingId",
            "previous",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "seq",
        "step",
        "source",
        "frameId",
        "kind",
        "data"
      ],
      "additionalProperties": false
    },
    "UPDATE": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "#/$defs/positive"
        },
        "step": {
          "$ref": "#/$defs/positive"
        },
        "source": {
          "$ref": "#/$defs/sourceRange"
        },
        "frameId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "UPDATE"
        },
        "data": {
          "type": "object",
          "properties": {
            "bindingId": {
              "$ref": "#/$defs/id"
            },
            "previous": {
              "$ref": "#/$defs/stateValue"
            },
            "value": {
              "$ref": "#/$defs/value"
            },
            "result": {
              "$ref": "#/$defs/value"
            },
            "operator": {
              "type": "string",
              "enum": [
                "++",
                "--"
              ]
            },
            "position": {
              "type": "string",
              "enum": [
                "prefix",
                "postfix"
              ]
            }
          },
          "required": [
            "bindingId",
            "previous",
            "value",
            "result",
            "operator",
            "position"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "seq",
        "step",
        "source",
        "frameId",
        "kind",
        "data"
      ],
      "additionalProperties": false
    },
    "ALLOCATE": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "#/$defs/positive"
        },
        "step": {
          "$ref": "#/$defs/positive"
        },
        "source": {
          "$ref": "#/$defs/sourceRange"
        },
        "frameId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "ALLOCATE"
        },
        "data": {
          "type": "object",
          "properties": {
            "object": {
              "$ref": "#/$defs/object"
            }
          },
          "required": [
            "object"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "seq",
        "step",
        "source",
        "frameId",
        "kind",
        "data"
      ],
      "additionalProperties": false
    },
    "ARRAY_READ": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "#/$defs/positive"
        },
        "step": {
          "$ref": "#/$defs/positive"
