    "text": "public class Main {\n    static int check(int n) {\n        if (n < 0) throw new IllegalArgumentException(\"negative\");\n        return n;\n    }\n    public static void main(String[] args) {\n        int r = 0;\n        try {\n            r = check(-1);\n        } catch (IllegalArgumentException e) {\n            r = -1;\n        }\n    }\n}\n",
