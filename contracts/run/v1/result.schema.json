{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KhoaKhoa811/code-visualization-2/contracts/run/v1/result.schema.json",
  "title": "Run lifecycle snapshot 1.0.0",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])" },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "phase": { "enum": ["queued", "preparing", "compiling", "executing", "stopping", "cleaning", "finished"] },
    "terminationConfirmed": { "type": "boolean" },
    "cleanupVerified": { "type": "boolean" },
    "slotHeld": { "type": "boolean" },
    "trace": { "oneOf": [{ "type": "null" }, { "$ref": "../../trace/v1/trace.schema.json" }] },
    "infrastructureFailures": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": { "enum": ["SETUP_FAILED", "WORKER_FAILED", "TRANSPORT_FAILED", "TERMINATION_UNCONFIRMED", "CLEANUP_UNCONFIRMED"] }
    }
  },
  "required": ["schemaVersion", "runId", "sourceSha256", "revision", "phase", "terminationConfirmed", "cleanupVerified", "slotHeld", "trace", "infrastructureFailures"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "phase": { "enum": ["queued", "preparing", "compiling", "executing", "stopping"] } } },
      "then": { "properties": { "terminationConfirmed": { "const": false }, "cleanupVerified": { "const": false }, "trace": { "type": "null" } } },
      "else": { "properties": { "terminationConfirmed": { "const": true } } }
    },
    {
      "if": { "properties": { "phase": { "enum": ["preparing", "compiling", "executing", "cleaning"] } } },
      "then": { "properties": { "slotHeld": { "const": true } } }
    },
    {
      "if": { "properties": { "phase": { "enum": ["queued", "finished"] } } },
      "then": { "properties": { "slotHeld": { "const": false } } }
    },
    {
      "if": { "properties": { "phase": { "const": "finished" } } },
      "then": { "properties": { "cleanupVerified": { "const": true } } },
      "else": { "properties": { "cleanupVerified": { "const": false } } }
    },
    {
      "if": { "properties": { "phase": { "const": "queued" } } },
      "then": { "properties": { "infrastructureFailures": { "type": "array", "maxItems": 0 } } }
    }
  ]
}
